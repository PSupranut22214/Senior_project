    "horizon = 864\n",
    "step_min = 5\n",
    "number_site = 48\n",
    "new_table = pd.DataFrame()\n",
    "# map from base on forecast to base on target\n",
    "if \"Site_id\" in forcast_data.columns:\n",
    "    all_sites = []\n",
    "    for number in range(1,number_site+1):\n",
    "        create = target_time[target_time[\"Site_id\"] == number].copy()\n",
    "        forecast_site = forcast_data[forcast_data[\"Site_id\"] == number].copy()\n",
    "        for k in range(1, horizon + 1):\n",
    "            forecast_col = f\"I_hat(t+{k}|t)\"\n",
    "            target_col = f\"I_hat(t|t-{k})\"\n",
    "\n",
    "            if forecast_col not in forecast_site.columns:\n",
    "                continue\n",
    "\n",
    "            mapped_time = forecast_site[\"Datetime\"] + pd.to_timedelta(k * step_min, unit=\"min\")\n",
    "\n",
    "            mapper = pd.Series(\n",
    "                data=forecast_site[forecast_col].values,\n",
    "                index=mapped_time\n",
    "            )\n",
    "\n",
    "            create[target_col] = create[\"target_time\"].map(mapper)\n",
    "            \n",
    "        all_sites.append(create)\n",
    "        \n",
    "    new_table = pd.concat(all_sites,axis = 0)\n",
    "    target_time = new_table\n",
    "else:\n",
    "    for k in range(1, horizon + 1):\n",
    "\n",
    "        forecast_col = f\"I_hat(t+{k}|t)\"\n",
    "        target_col = f\"I_hat(t|t-{k})\"\n",
    "\n",
    "        if forecast_col not in forcast_data.columns:\n",
    "            continue\n",
    "\n",
    "        mapped_time = forcast_data[\"Datetime\"] + pd.to_timedelta(k * step_min, unit=\"min\")\n",
    "\n",
    "        mapper = pd.Series(\n",
    "                data=forcast_data[forecast_col].values,\n",
    "                index=mapped_time\n",
    "        )\n",
    "\n",
    "        target_time[target_col] = target_time[\"target_time\"].map(mapper)\n",
    "        "
   ]
